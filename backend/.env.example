# Variables are read from the process environment (Docker Compose loads root .env).
DATABASE_PATH=data/trail.db
MAP_USER_AGENT=TrailPocket-Hackathon/1.0
OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
OSRM_BIKE_URL=https://routing.openstreetmap.de/routed-bike
PHOTON_URL=https://photon.komoot.io
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Optional. Set on the server only; never put this key in the Android app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
